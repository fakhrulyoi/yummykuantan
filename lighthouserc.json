{
  "ci": {
    "collect": {
      "url": ["http://localhost:3100/", "http://localhost:3100/koleksi", "http://localhost:3100/kek/italian-cake"],
      "numberOfRuns": 3,
      "startServerCommand": "npx next start -p 3100",
      "startServerReadyPattern": "Ready",
      "settings": { "preset": "perf", "formFactor": "mobile", "chromeFlags": "--no-sandbox --headless=new" }
    },
    "assert": {
      "aggregationMethod": "median-run",
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 2500 }]
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
