# Postgres (Supabase: Settings > Database). DATABASE_URL guna pooler (port 6543, ?pgbouncer=true), DIRECT_URL untuk migrasi (port 5432).
DATABASE_URL="postgresql://yk:yk@localhost:5432/yk_dev"
DIRECT_URL="postgresql://yk:yk@localhost:5432/yk_dev"
# Supabase (Settings > API). Kunci service role hanya di server.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
# Garam rawak untuk hash IP (had kadar). Jana: openssl rand -hex 32
IP_HASH_SALT=""
